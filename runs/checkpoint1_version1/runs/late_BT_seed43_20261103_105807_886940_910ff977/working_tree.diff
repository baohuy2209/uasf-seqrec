+    for attribute, name in [('ndcg_10', 'NDCG@10'), ('recall_10', 'Recall@10'),
+                            ('ndcg_20', 'NDCG@20'), ('recall_20', 'Recall@20')]:
+        if hasattr(result, attribute):
