# Local Python environments and caches
.venv/
.venv-wsl/
.venv-cuda/
__pycache__/
*.py[cod]
.pytest_cache/

# Datasets and generated experiment outputs
/data/
.tmp/

# Large arrays and model scores (>100MB)
*.npy
*.npz
!artifacts/**/*.npy

# Editable-install and package build metadata
*.egg-info/
build/
dist/
docs/
.agents
skills-lock.json
*.pt


# Keep the scientific decision log versioned without adding other local docs.
!docs/
docs/*
!docs/decision_log.md


