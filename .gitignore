# Local environments and Python/build caches
.venv*/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
/build/
/dist/
/release_dist/
/.tmp/

# Original data, embeddings, checkpoints, and historical execution records stay local.
/data/
/runs/
/reports/
/artifacts/*
!/artifacts/README.md
/results/*
!/results/README.md
!/results/paper/
*.pt
*.npy
*.npz
*.log
*.bak

# Publish only the maintained project documentation.
/docs/*
!/docs/decision_log.md
!/docs/REPRODUCIBILITY.md
!/docs/history/

# Agent/editor state and credentials
/.agents/
/.specify/
/specs/
/AGENTS.md
/skills-lock.json
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
