# Source and documentation use LF on every platform.
* text=auto eol=lf

# Publication evidence must retain the bytes bound to its checksums.
results/paper/** -text

# Keep local historical artifact policies; do not normalize frozen files in place.
artifacts/metadata/** -text whitespace=-blank-at-eol
runs/** text=auto !eol
reports/** text=auto !eol

# Source archives omit local execution data and agent state.
data export-ignore
runs export-ignore
reports export-ignore
artifacts/metadata export-ignore
.agents export-ignore
.specify export-ignore
specs export-ignore
AGENTS.md export-ignore
skills-lock.json export-ignore
